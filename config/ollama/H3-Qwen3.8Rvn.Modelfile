FROM Qwen3.8Rvn:latest

# H3 Design uses long agent/tool prompts. 40K leaves room for a compact
# skill/tool prompt and image attachment without reserving the 131K maximum.
PARAMETER num_ctx 40960
PARAMETER num_predict 8192
PARAMETER temperature 0.2
PARAMETER top_k 20
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.05
